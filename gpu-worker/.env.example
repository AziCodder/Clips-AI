# GPU Worker - copy to .env and fill values
# On Vast.ai: these are passed via extra_env when CPU starts the instance

# ---- CPU API (required) ------------------------------------------------------
# By domain: https://your-domain.com/api/v1
# By IP: http://YOUR_SERVER_IP:8001/api/v1
CPU_API_BASE_URL=http://YOUR_SERVER_IP:8001/api/v1
GPU_API_KEY=CHANGE_ME_SAME_AS_CPU_BACKEND

# ---- S3 (required) -----------------------------------------------------------
S3_ENDPOINT_URL=https://s3-nl.hostkey.com
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY
S3_BUCKET=bc4d77ea-clips-ai-s3-storage190904

# ---- Transcription (Transformers pipeline + WhisperX alignment, optional) ----
WHISPER_MODEL_NAME=openai/whisper-large-v3
WHISPER_DEVICE=cuda
WHISPER_BATCH_SIZE=24
WHISPER_USE_FLASH_ATTN=true
WORKER_ID=vastai-worker-1
WORK_DIR=/tmp/clips_worker
LOG_LEVEL=INFO
